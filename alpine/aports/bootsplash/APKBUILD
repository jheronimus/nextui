# shellcheck shell=sh disable=SC2034,SC2154,SC3043
pkgname=bootsplash
pkgver=1.0.0
pkgrel=1
pkgdesc="Direct DRM/KMS early bootsplash daemon"
url="https://github.com/jheronimus/nextui"
arch="aarch64"
license="MIT"
options="!check"
makedepends="linux-headers"
source="
	bootsplash.c
	Makefile
	stb_image.h
"

build() {
	make -C "$srcdir" CC="${CC:-gcc}" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS"
}

package() {
	install -Dm755 "$srcdir/bootsplash" "$pkgdir/usr/bin/bootsplash"
}

