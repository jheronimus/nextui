# RK3326 (px30) uses the vendor Rockchip boot chain: the miniloader loads
# uboot.img (U-Boot proper) at 0x00200000, so U-Boot must be linked there.
# U-Boot >= 2026.07 defaults TEXT_BASE to 0x00800000 (SPL/FIT maskrom path),
# which does not match the miniloader load address.
CONFIG_SYS_TEXT_BASE=0x00200000
