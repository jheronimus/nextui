# Assembly for the alpine platform.
#
# MinUI's equivalent is a no-op ("Copied platform specifics"). Ours cannot be:
# NextUI's top-level makefile assembles the SD-card payload with ~50 hardcoded
# `cp` lines gated on `tg5040|tg5050`, and since we may not edit that file there
# is nowhere to add an `alpine` branch. This is that logic, for this target.
#
# Invoked as: make -f makefile.copy PLATFORM=alpine WORKSPACE_DIR=... ALPINE_DIR=...
#
# Convention mirrors NextUI: binaries land in build/SYSTEM/$(PLATFORM)/bin,
# shared libraries in build/SYSTEM/$(PLATFORM)/lib.

PLATFORM ?= alpine
WORKSPACE_DIR ?= $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../..)
NEXTUI_ROOT ?= $(abspath $(WORKSPACE_DIR)/..)
ALPINE_DIR ?= $(NEXTUI_ROOT)/alpine
PORT_DIR := $(WORKSPACE_DIR)/$(PLATFORM)

BUILD := $(WORKSPACE_DIR)/build
SYS := $(BUILD)/SYSTEM/$(PLATFORM)
A := $(WORKSPACE_DIR)/all
P := $(WORKSPACE_DIR)/$(PLATFORM)

.PHONY: $(PLATFORM)

$(PLATFORM):
	@mkdir -p $(SYS)/bin $(SYS)/lib $(SYS)/cores $(BUILD)/EXTRAS/Tools/$(PLATFORM)

	@echo "==> core binaries"
	cp -f $(A)/nextui/build/$(PLATFORM)/nextui.elf $(SYS)/bin/
	cp -f $(A)/minarch/build/$(PLATFORM)/minarch.elf $(SYS)/bin/

	@echo "==> settings + libmsettings"
	cp -f $(P)/libmsettings/libmsettings.so $(SYS)/lib/
	@if [ -f $(A)/settings/build/$(PLATFORM)/settings.elf ]; then \
		mkdir -p "$(BUILD)/EXTRAS/Tools/$(PLATFORM)/Settings.pak"; \
		cp -f $(A)/settings/build/$(PLATFORM)/settings.elf "$(BUILD)/EXTRAS/Tools/$(PLATFORM)/Settings.pak/"; \
	fi

	@echo "==> input"
	@if [ -f $(P)/keymon/build/$(PLATFORM)/keymon.elf ]; then \
		cp -f $(P)/keymon/build/$(PLATFORM)/keymon.elf $(SYS)/bin/; \
	elif [ -f $(P)/keymon/keymon.elf ]; then \
		cp -f $(P)/keymon/keymon.elf $(SYS)/bin/; \
	fi

	@echo "==> first-boot show (device.cfg generator)"
	@if [ -f $(P)/show/build/$(PLATFORM)/show.elf ]; then \
		cp -f $(P)/show/build/$(PLATFORM)/show.elf $(SYS)/bin/; \
	elif [ -f $(P)/show/show.elf ]; then \
		cp -f $(P)/show/show.elf $(SYS)/bin/; \
	fi

	@echo "==> tools and extras"
	@if [ -f $(A)/nextval/build/$(PLATFORM)/nextval.elf ]; then \
		cp -f $(A)/nextval/build/$(PLATFORM)/nextval.elf $(SYS)/bin/; \
	fi
	@if [ -f $(A)/clock/build/$(PLATFORM)/clock.elf ]; then \
		mkdir -p "$(BUILD)/EXTRAS/Tools/$(PLATFORM)/Clock.pak"; \
		cp -f $(A)/clock/build/$(PLATFORM)/clock.elf "$(BUILD)/EXTRAS/Tools/$(PLATFORM)/Clock.pak/"; \
	fi
	@if [ -f $(A)/minput/build/$(PLATFORM)/minput.elf ]; then \
		mkdir -p "$(BUILD)/EXTRAS/Tools/$(PLATFORM)/Input.pak"; \
		cp -f $(A)/minput/build/$(PLATFORM)/minput.elf "$(BUILD)/EXTRAS/Tools/$(PLATFORM)/Input.pak/"; \
	fi
	@if [ -f $(A)/libbatmondb/build/$(PLATFORM)/libbatmondb.so ]; then \
		cp -f $(A)/libbatmondb/build/$(PLATFORM)/libbatmondb.so $(SYS)/lib/; \
		cp -f $(A)/batmon/build/$(PLATFORM)/batmon.elf $(SYS)/bin/; \
		mkdir -p "$(BUILD)/EXTRAS/Tools/$(PLATFORM)/Battery.pak"; \
		cp -f $(A)/battery/build/$(PLATFORM)/battery.elf "$(BUILD)/EXTRAS/Tools/$(PLATFORM)/Battery.pak/"; \
	fi
	@if [ -f $(A)/libgametimedb/build/$(PLATFORM)/libgametimedb.so ]; then \
		cp -f $(A)/libgametimedb/build/$(PLATFORM)/libgametimedb.so $(SYS)/lib/; \
		cp -f $(A)/gametimectl/build/$(PLATFORM)/gametimectl.elf $(SYS)/bin/; \
		mkdir -p "$(BUILD)/EXTRAS/Tools/$(PLATFORM)/Game Tracker.pak"; \
		cp -f $(A)/gametime/build/$(PLATFORM)/gametime.elf "$(BUILD)/EXTRAS/Tools/$(PLATFORM)/Game Tracker.pak/"; \
	fi
	@if [ -f $(A)/bootlogo/build/$(PLATFORM)/bootlogo.elf ]; then \
		mkdir -p "$(BUILD)/EXTRAS/Tools/$(PLATFORM)/Bootlogo.pak"; \
		cp -f $(A)/bootlogo/build/$(PLATFORM)/bootlogo.elf "$(BUILD)/EXTRAS/Tools/$(PLATFORM)/Bootlogo.pak/"; \
	fi

	@echo "==> runtime libraries"
	@for so in libsamplerate.so.0 libzip.so.5 liblzma.so.5 \
	          libzstd.so.1 liblz4.so.1 libcrypto.so.3 libchdr.so; do \
		src=""; \
		for d in $(SYS)/lib $(A)/minarch/build/$(PLATFORM) $(PREFIX_LOCAL)/lib /usr/lib /lib; do \
			[ -e "$$d/$$so" ] && { src="$$d/$$so"; break; }; \
		done; \
		if [ -n "$$src" ]; then cp -f "$$src" $(SYS)/lib/; \
		else echo "    WARN: $$so not found, NextUI runtime may fail to dlopen it" >&2; fi; \
	done
	@for bz in /usr/lib/libbz2.so.* /lib/libbz2.so.*; do \
		if [ -f "$$bz" ]; then cp -f "$$bz" $(SYS)/lib/; break; fi; \
	done

	@echo "==> version"
	@mkdir -p $(NEXTUI_ROOT)/releases
	@printf '%s\n%s\n' \
		"$(shell cd $(NEXTUI_ROOT) && make --no-print-directory name)" \
		"$(shell cd $(NEXTUI_ROOT) && git rev-parse --short HEAD 2>/dev/null || echo unknown)" \
		> $(SYS)/version.txt
	@echo "==> emulation cores"
	@if [ -d $(P)/cores/output ]; then \
		for core in $(P)/cores/output/*_libretro.so; do \
			[ -f "$$core" ] || continue; \
			name="$$(basename "$$core")"; \
			case "$$name" in \
				fceumm_libretro.so|gambatte_libretro.so|gpsp_libretro.so|picodrive_libretro.so|snes9x_libretro.so|pcsx_rearmed_libretro.so) \
					cp -f "$$core" $(SYS)/cores/ ;; \
				*) \
					;; \
			esac; \
		done; \
		[ -f $(P)/cores/output/a5200_libretro.so ] && cp -f $(P)/cores/output/a5200_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/A5200.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/prosystem_libretro.so ] && cp -f $(P)/cores/output/prosystem_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/A7800.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/stella2014_libretro.so ] && cp -f $(P)/cores/output/stella2014_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/A2600.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/handy_libretro.so ] && cp -f $(P)/cores/output/handy_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/LYNX.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/fake08_libretro.so ] && cp -f $(P)/cores/output/fake08_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/P8.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/mgba_libretro.so ] && cp -f $(P)/cores/output/mgba_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/MGBA.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/mgba_libretro.so ] && cp -f $(P)/cores/output/mgba_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/SGB.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/mednafen_pce_fast_libretro.so ] && cp -f $(P)/cores/output/mednafen_pce_fast_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/PCE.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/pokemini_libretro.so ] && cp -f $(P)/cores/output/pokemini_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/PKM.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/race_libretro.so ] && cp -f $(P)/cores/output/race_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/NGP.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/race_libretro.so ] && cp -f $(P)/cores/output/race_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/NGPC.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/fbneo_libretro.so ] && cp -f $(P)/cores/output/fbneo_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/FBN.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/mednafen_supafaust_libretro.so ] && cp -f $(P)/cores/output/mednafen_supafaust_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/SUPA.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/mednafen_vb_libretro.so ] && cp -f $(P)/cores/output/mednafen_vb_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/VB.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/cap32_libretro.so ] && cp -f $(P)/cores/output/cap32_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/CPC.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/puae2021_libretro.so ] && cp -f $(P)/cores/output/puae2021_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/PUAE.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/prboom_libretro.so ] && cp -f $(P)/cores/output/prboom_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/PRBOOM.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/vice_x64_libretro.so ] && cp -f $(P)/cores/output/vice_x64_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/C64.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/vice_x128_libretro.so ] && cp -f $(P)/cores/output/vice_x128_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/C128.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/vice_xplus4_libretro.so ] && cp -f $(P)/cores/output/vice_xplus4_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/PLUS4.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/vice_xpet_libretro.so ] && cp -f $(P)/cores/output/vice_xpet_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/PET.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/vice_xvic_libretro.so ] && cp -f $(P)/cores/output/vice_xvic_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/VIC.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/bluemsx_libretro.so ] && cp -f $(P)/cores/output/bluemsx_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/MSX.pak/ 2>/dev/null || true; \
		[ -f $(P)/cores/output/gearcoleco_libretro.so ] && cp -f $(P)/cores/output/gearcoleco_libretro.so $(BUILD)/EXTRAS/Emus/$(PLATFORM)/COLECO.pak/ 2>/dev/null || true; \
	fi

	@echo "assembled $(SYS)"
